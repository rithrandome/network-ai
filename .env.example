# Which model does what. Each role can use a different provider:
#   ollama (local, free) | anthropic (Claude) | openai (GPT)
# LLM_PROVIDER is the default; EXTRACT_PROVIDER / COMPOSE_PROVIDER override it.
# Common setup: read resumes and profiles locally, write drafts with a cloud model.
LLM_PROVIDER=ollama
EXTRACT_PROVIDER=
COMPOSE_PROVIDER=

# Local model - must already be pulled: `ollama pull gemma3:1b`
OLLAMA_MODEL=gemma3:1b

# Claude (https://console.anthropic.com)
ANTHROPIC_API_KEY=
CLAUDE_EXTRACT_MODEL=claude-haiku-4-5-20251001
CLAUDE_COMPOSE_MODEL=claude-sonnet-5

# OpenAI GPT (https://platform.openai.com/api-keys)
OPENAI_API_KEY=
OPENAI_EXTRACT_MODEL=gpt-6-luna
OPENAI_COMPOSE_MODEL=gpt-6.1-sol
# Reasoning effort for GPT-5 and later: low (default) | medium | high | xhigh
OPENAI_REASONING_EFFORT=low

# Exa - person resolution (https://dashboard.exa.ai)
EXA_API_KEY=
# live = cache-first (default) | offline = cache only, never spends | mock = fictional fixture, no key
EXA_MODE=live

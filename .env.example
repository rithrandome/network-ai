# Chat model provider: ollama (default, local, free) | anthropic (needs credit)
LLM_PROVIDER=ollama

# Local model - must already be pulled: `ollama pull gemma3:1b`
OLLAMA_MODEL=gemma3:1b

# Claude - only used when LLM_PROVIDER=anthropic (https://console.anthropic.com)
ANTHROPIC_API_KEY=
EXTRACT_MODEL=claude-haiku-4-5-20251001
COMPOSE_MODEL=claude-sonnet-5

# Exa - person resolution (https://dashboard.exa.ai)
EXA_API_KEY=
# live = cache-first (default) | offline = cache only, never spends | mock = fictional fixture, no key
EXA_MODE=live
